# paperclip-mcp configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Required — Base URL of your Paperclip instance.
# Default (local install): http://localhost:3100/api
# Change only if you have a remote or differently configured Paperclip instance.
PAPERCLIP_BASE_URL=http://localhost:3100/api

# Required — Agent API key.
# Generate in Paperclip UI: Settings → API Keys → New Key.
# Keep this secret: it grants write access to your company's data.
PAPERCLIP_API_KEY=

# Required — Company UUID to operate on.
# Find it in the Paperclip UI URL when viewing your company:
#   http://localhost:3100/companies/{PAPERCLIP_COMPANY_ID}
PAPERCLIP_COMPANY_ID=

# Optional — Active Paperclip heartbeat run ID. Set only while this MCP request
# belongs to a real live run. When empty, paperclip-mcp sends no run header.
PAPERCLIP_RUN_ID=

# Optional — Comma-separated tool names or categories to hide from MCP clients.
# Empty means every tool is enabled. Valid categories: issues, agents, goals,
# projects, approvals, costs, monitoring, secrets, routines, companies.
# Example: PAPERCLIP_DISABLED_TOOLS=secrets,delete_agent
PAPERCLIP_DISABLED_TOOLS=
